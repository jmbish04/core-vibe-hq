{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "structured-output",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-29",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"traces": { "enabled": false },
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"ai": {
		"binding": "AI"
	}
}
