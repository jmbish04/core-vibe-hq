{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "image-generation",
	"main": "src/index.ts",
	"compatibility_date": "2025-02-24",
	"observability": {
		"enabled": true,
		"traces": { "enabled": false },
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"ai": {
		"binding": "AI"
	}
}
